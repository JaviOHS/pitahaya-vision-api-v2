# ===== DJANGO CORE =====

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

TIME_ZONE=America/Guayaquil
PRODUCTION=False

# ===== DATABASE =====

DB_ENGINE=sqlite
DB_NAME=pitahaya_vision_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ===== SUPERUSER =====

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=your-password

# ===== CORS =====

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/recuperar-cuenta/confirmar
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verificar-correo

# ===== EMAIL =====

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@pitahaya-vision.local
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# ===== SEGURIDAD - Límite de intentos de login =====

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_THROTTLE_RATE=3/minute

# ===== APIs =====
# ===== Modelo Gemma =====

VISUAL_CROSSING_API_KEY=
CHATBOT_SERVICE_URL=https://your-ngrok-url.ngrok-free.dev
CHATBOT_SERVICE_TIMEOUT=120

# ===== Modelos de análisis =====

ANALYSIS_SERVICE_URL=http://localhost:8001
ANALYSIS_SERVICE_TIMEOUT=60

# ===== Localización =====

GEO_LOCALITATION=your-geo-api-key

# ===== Clima =====

VISUAL_CROSSING_API_KEY=your-visual-crossing-key
